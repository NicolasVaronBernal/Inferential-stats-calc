<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Estadística — Prueba de Hipótesis e IC</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: system-ui, sans-serif; background: #f5f5f5; color: #1a1a1a; padding: 2rem; }
  h1 { font-size: 20px; font-weight: 500; margin-bottom: 2rem; }
  .tabs { display: flex; gap: 4px; border-bottom: 1px solid #ddd; margin-bottom: 2rem; }
  .tab-btn { padding: 8px 20px; background: none; border: none; border-bottom: 2px solid transparent; font-size: 14px; color: #888; cursor: pointer; margin-bottom: -1px; }
  .tab-btn.active { border-bottom: 2px solid #1a1a1a; color: #1a1a1a; font-weight: 500; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
  label { font-size: 13px; color: #666; display: block; margin-bottom: 4px; }
  input[type="number"], select { width: 100%; padding: 8px 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; background: #fff; }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .params { display: flex; flex-direction: column; gap: 1rem; }
  .results { display: flex; flex-direction: column; gap: 12px; }
  .metric { background: #f0f0f0; border-radius: 8px; padding: 1rem; }
  .metric p:first-child { font-size: 12px; color: #888; margin-bottom: 4px; }
  .metric p:last-child { font-size: 22px; font-weight: 500; }
  .conclusion { border-radius: 8px; padding: 1rem; font-size: 13px; line-height: 1.5; }
  .conclusion.reject { background: rgba(226,75,74,0.1); border: 1px solid rgba(226,75,74,0.3); color: #a32d2d; }
  .conclusion.accept { background: rgba(29,158,117,0.1); border: 1px solid rgba(29,158,117,0.3); color: #0f6e56; }
  .chart-wrap { position: relative; width: 100%; height: 220px; margin-top: 1rem; }
  section-title { font-size: 13px; color: #888; display: block; margin-bottom: 8px; }
</style>
</head>
<body>

<h1>Solucionario de Parcial — Estadística</h1>

<div class="tabs">
  <button class="tab-btn active" id="tab1" onclick="showTab(1)">Prueba t de Student</button>
  <button class="tab-btn" id="tab2" onclick="showTab(2)">Intervalo de confianza</button>
</div>

<!-- Panel 1 -->
<div id="panel1">
  <div class="grid">
    <div class="params">
      <span style="font-size:13px;color:#888;">Parámetros</span>
      <div class="field"><label>μ₀ — Media poblacional</label><input type="number" id="mu0" value="850" oninput="calcT()"></div>
      <div class="field"><label>x̄ — Media muestral</label><input type="number" id="xbar" value="812" oninput="calcT()"></div>
      <div class="field"><label>s — Desviación estándar</label><input type="number" id="s" value="74" oninput="calcT()"></div>
      <div class="field"><label>n — Tamaño de muestra</label><input type="number" id="n" value="18" min="2" oninput="calcT()"></div>
      <div class="field"><label>α — Nivel de significancia</label>
        <select id="alpha" onchange="calcT()">
          <option value="0.10">0.10</option>
          <option value="0.05" selected>0.05</option>
          <option value="0.01">0.01</option>
        </select>
      </div>
      <div class="field"><label>Tipo de prueba</label>
        <select id="tailT" onchange="calcT()">
          <option value="left">Cola izquierda (H₁: μ &lt; μ₀)</option>
          <option value="right">Cola derecha (H₁: μ > μ₀)</option>
          <option value="two">Dos colas (H₁: μ ≠ μ₀)</option>
        </select>
      </div>
    </div>
    <div class="results">
      <span style="font-size:13px;color:#888;">Resultados</span>
      <div class="metric"><p>Estadístico t calculado</p><p id="tCalc">—</p></div>
      <div class="metric"><p>Valor crítico t</p><p id="tCrit">—</p></div>
      <div class="metric"><p>Grados de libertad</p><p id="dfOut">—</p></div>
      <div class="conclusion" id="conclusionT"></div>
    </div>
  </div>
  <div class="chart-wrap"><canvas id="chartT" role="img" aria-label="Distribución t con región de rechazo"></canvas></div>
</div>

<!-- Panel 2 -->
<div id="panel2" style="display:none;">
  <div class="grid">
    <div class="params">
      <span style="font-size:13px;color:#888;">Parámetros</span>
      <div class="field"><label>n — Tamaño de muestra</label><input type="number" id="n2" value="400" min="1" oninput="calcIC()"></div>
      <div class="field"><label>Éxitos observados</label><input type="number" id="exitos" value="312" min="0" oninput="calcIC()"></div>
      <div class="field"><label>Nivel de confianza</label>
        <select id="conf" onchange="calcIC()">
          <option value="0.90">90%</option>
          <option value="0.95" selected>95%</option>
          <option value="0.99">99%</option>
        </select>
      </div>
    </div>
    <div class="results">
      <span style="font-size:13px;color:#888;">Resultados</span>
      <div class="metric"><p>Proporción muestral p̂</p><p id="phat">—</p></div>
      <div class="metric"><p>Intervalo de confianza</p><p id="ic" style="font-size:18px;">—</p></div>
      <div class="metric"><p>Margen de error</p><p id="me">—</p></div>
    </div>
  </div>
  <div class="chart-wrap"><canvas id="chartIC" role="img" aria-label="Normal estándar con IC sombreado"></canvas></div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
let chartTObj = null, chartICObj = null;

function showTab(n) {
  document.getElementById('panel1').style.display = n === 1 ? 'block' : 'none';
  document.getElementById('panel2').style.display = n === 2 ? 'block' : 'none';
  document.getElementById('tab1').className = 'tab-btn' + (n === 1 ? ' active' : '');
  document.getElementById('tab2').className = 'tab-btn' + (n === 2 ? ' active' : '');
  if (n === 2 && !chartICObj) setTimeout(calcIC, 50);
}

function tPDF(x, df) {
  const lg = (z) => {
    const p = [0.99999999999980993,676.5203681218851,-1259.1392167224028,771.32342877765313,-176.61502916214059,12.507343278686905,-0.13857109526572012,9.9843695780195716e-6,1.5056327351493116e-7];
    if (z < 0.5) return Math.log(Math.PI / Math.sin(Math.PI*z)) - lg(1-z);
    z -= 1; let a = p[0]; const t2 = z + 7.5;
    for (let i = 1; i < 9; i++) a += p[i]/(z+i);
    return 0.5*Math.log(2*Math.PI) + (z+0.5)*Math.log(t2) - t2 + Math.log(a);
  };
  return Math.exp(lg((df+1)/2) - 0.5*Math.log(df*Math.PI) - lg(df/2) - ((df+1)/2)*Math.log(1+x*x/df));
}

function normPDF(x) { return Math.exp(-0.5*x*x) / Math.sqrt(2*Math.PI); }

function tCritical(df, alpha, tail) {
  const tVals = {
    0.10: {1:3.078,2:1.886,3:1.638,4:1.533,5:1.476,6:1.440,7:1.415,8:1.397,9:1.383,10:1.372,11:1.363,12:1.356,13:1.350,14:1.345,15:1.341,16:1.337,17:1.333,18:1.330,19:1.328,20:1.325,25:1.316,30:1.310,999:1.282},
    0.05: {1:6.314,2:2.920,3:2.353,4:2.132,5:2.015,6:1.943,7:1.895,8:1.860,9:1.833,10:1.812,11:1.796,12:1.782,13:1.771,14:1.761,15:1.753,16:1.746,17:1.740,18:1.734,19:1.729,20:1.725,25:1.708,30:1.697,999:1.645},
    0.01: {1:31.821,2:6.965,3:4.541,4:3.747,5:3.365,6:3.143,7:2.998,8:2.896,9:2.821,10:2.764,11:2.718,12:2.681,13:2.650,14:2.624,15:2.602,16:2.583,17:2.567,18:2.552,19:2.539,20:2.528,25:2.485,30:2.457,999:2.326}
  };
  const a = parseFloat(alpha);
  const row = tVals[a] || tVals[0.05];
  const dfKey = row[df] !== undefined ? df : (df > 30 ? 999 : 30);
  const cv = row[dfKey] || 1.96;
  if (tail === 'left') return -cv;
  if (tail === 'right') return cv;
  return cv;
}

function calcT() {
  const mu0 = parseFloat(document.getElementById('mu0').value)||850;
  const xbar = parseFloat(document.getElementById('xbar').value)||812;
  const s = parseFloat(document.getElementById('s').value)||74;
  const n = parseInt(document.getElementById('n').value)||18;
  const alpha = document.getElementById('alpha').value;
  const tail = document.getElementById('tailT').value;
  const df = n - 1;
  const t = (xbar - mu0) / (s / Math.sqrt(n));
  const tcrit = tCritical(df, alpha, tail);

  document.getElementById('tCalc').textContent = t.toFixed(4);
  document.getElementById('tCrit').textContent = tail === 'two' ? `±${Math.abs(tcrit).toFixed(3)}` : tcrit.toFixed(3);
  document.getElementById('dfOut').textContent = df;

  let reject = false;
  if (tail === 'left') reject = t < tcrit;
  if (tail === 'right') reject = t > tcrit;
  if (tail === 'two') reject = Math.abs(t) > Math.abs(tcrit);

  const el = document.getElementById('conclusionT');
  el.className = 'conclusion ' + (reject ? 'reject' : 'accept');
  el.innerHTML = reject
    ? '<strong>Rechazamos H₀</strong> — el estadístico cae en la región de rechazo.'
    : '<strong>No rechazamos H₀</strong> — no hay evidencia suficiente contra la hipótesis nula.';

  drawTChart(t, tcrit, df, tail);
}

function drawTChart(tCalc, tCrit, df, tail) {
  const pts = 200, xMin = -5, xMax = 5, step = (xMax-xMin)/pts;
  const labels = [], dataLine = [], fillReject = [], fillCalc = [];
  for (let i = 0; i <= pts; i++) {
    const x = xMin + i*step;
    labels.push(x.toFixed(2));
    const y = tPDF(x, df);
    dataLine.push(y);
    let inR = false;
    if (tail==='left' && x<=tCrit) inR=true;
    if (tail==='right' && x>=tCrit) inR=true;
    if (tail==='two' && (x<=-Math.abs(tCrit)||x>=Math.abs(tCrit))) inR=true;
    fillReject.push(inR ? y : null);
    fillCalc.push(Math.abs(x-tCalc)<step*1.5 ? y : null);
  }
  const ctx = document.getElementById('chartT').getContext('2d');
  if (chartTObj) chartTObj.destroy();
  chartTObj = new Chart(ctx, {
    type: 'line',
    data: { labels, datasets: [
      { data: dataLine, borderColor: '#378add', borderWidth: 1.5, fill: false, pointRadius: 0, tension: 0.4 },
      { data: fillReject, borderColor: 'transparent', backgroundColor: 'rgba(226,75,74,0.25)', fill: true, pointRadius: 0, tension: 0.4 },
      { data: fillCalc, borderColor: 'transparent', backgroundColor: 'rgba(186,117,23,0.55)', fill: true, pointRadius: 0, tension: 0.4 },
    ]},
    options: { responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { enabled: false } },
      scales: { x: { ticks: { maxTicksLimit: 11, color: '#888', font: { size: 11 } }, grid: { color: 'rgba(128,128,128,0.1)' } }, y: { ticks: { display: false }, grid: { display: false }, border: { display: false } } }
    }
  });
}

function calcIC() {
  const n = parseInt(document.getElementById('n2').value)||400;
  const exitos = parseInt(document.getElementById('exitos').value)||312;
  const conf = parseFloat(document.getElementById('conf').value);
  const zMap = { 0.90: 1.645, 0.95: 1.96, 0.99: 2.576 };
  const z = zMap[conf]||1.96;
  const phat = exitos/n;
  const error = z * Math.sqrt((phat*(1-phat))/n);
  document.getElementById('phat').textContent = phat.toFixed(4);
  document.getElementById('ic').textContent = `[${(phat-error).toFixed(4)}, ${(phat+error).toFixed(4)}]`;
  document.getElementById('me').textContent = `± ${error.toFixed(4)}`;
  drawICChart(z, conf);
}

function drawICChart(z, conf) {
  const pts = 200, xMin = -4, xMax = 4, step = (xMax-xMin)/pts;
  const labels = [], dataLine = [], fillCI = [];
  for (let i = 0; i <= pts; i++) {
    const x = xMin + i*step;
    labels.push(x.toFixed(2));
    const y = normPDF(x);
    dataLine.push(y);
    fillCI.push(x>=-z && x<=z ? y : null);
  }
  const ctx = document.getElementById('chartIC').getContext('2d');
  if (chartICObj) chartICObj.destroy();
  chartICObj = new Chart(ctx, {
    type: 'line',
    data: { labels, datasets: [
      { data: dataLine, borderColor: '#378add', borderWidth: 1.5, fill: false, pointRadius: 0, tension: 0.4 },
      { data: fillCI, borderColor: 'transparent', backgroundColor: 'rgba(29,158,117,0.25)', fill: true, pointRadius: 0, tension: 0.4 },
    ]},
    options: { responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { enabled: false } },
      scales: { x: { ticks: { maxTicksLimit: 9, color: '#888', font: { size: 11 } }, grid: { color: 'rgba(128,128,128,0.1)' } }, y: { ticks: { display: false }, grid: { display: false }, border: { display: false } } }
    }
  });
}

setTimeout(() => { calcT(); }, 80);
</script>
</body>
</html>
